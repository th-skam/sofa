<?xml version="1.0"?>
<!--
  Visual inspection scene for RegularGridTopology graded meshing.

  Six grids are shown at rest (no simulation) so the spacing distribution
  can be compared directly.  All grids share the same resolution (n=9 in
  each active axis, giving 8 cells per direction) and the same bounding box
  size (10×10 units).

  Top row — 3D hexahedral grids (nz=9):
    Left   : uniform baseline                   gradingRatio="1 1 1"  (grey)
    Centre : x-axis graded, r=3                 gradingRatio="3 1 1"  (blue)
             Points accumulate at x=min; cells grow toward x=max.
    Right  : x-axis graded, r=1/3               gradingRatio="0.33 1 1" (green)
             Reverse of the above; cells grow toward x=min.

  Bottom row — 2D quad grids (nz=1):
    Left   : uniform baseline                   gradingRatio="1 1 1"  (grey)
    Centre : both axes graded the same way      gradingRatio="3 3 1"  (orange)
             Points accumulate at (xmin, ymin); coarsens toward (xmax, ymax).
    Right  : axes graded in opposite directions gradingRatio="3 0.33 1" (red)
             Fine in x at start, fine in y at end — creates a corner refinement.

  Each node contains only:
    RegularGridTopology   — defines resolution, extent, and grading
    MechanicalObject      — holds the DOFs (initialised from the grid)
    OglModel (child node) — renders edges so internal spacing is visible
    IdentityMapping       — wires DOFs to the visual model
-->
<Node name="root" dt="1.0" gravity="0 0 0">

    <RequiredPlugin pluginName="Sofa.Component.Topology.Container.Grid"/>
    <RequiredPlugin pluginName="Sofa.Component.StateContainer"/>
    <RequiredPlugin pluginName="Sofa.Component.Mapping.Linear"/>
    <RequiredPlugin pluginName="Sofa.GL.Component.Rendering3D"/>
    <RequiredPlugin pluginName="Sofa.Component.Visual"/>

    <VisualStyle displayFlags="showVisual showWireframe"/>
    <DefaultAnimationLoop/>

    <!-- ================================================================
         TOP ROW: 3D hexahedral grids
         ================================================================ -->

    <!-- Grid 1: uniform reference (r=1, default) -->
    <Node name="3D_Uniform">
        <RegularGridTopology name="grid"
            n="9 9 9"
            min="0 0 0" max="10 10 10"
            gradingRatio="1 1 1"/>
        <MechanicalObject template="Vec3" name="dofs"/>
        <Node name="Visu">
            <OglModel name="Visual" color="0.6 0.6 0.6 1.0"
                edges="@../grid.edges"/>
            <IdentityMapping input="@../dofs" output="@Visual"/>
        </Node>
    </Node>

    <!-- Grid 2: x-axis graded r=3 — points dense at x=min -->
    <Node name="3D_X_graded_r3">
        <RegularGridTopology name="grid"
            n="9 9 9"
            min="13 0 0" max="23 10 10"
            gradingRatio="3 1 1"/>
        <MechanicalObject template="Vec3" name="dofs"/>
        <Node name="Visu">
            <OglModel name="Visual" color="0.2 0.4 0.9 1.0"
                edges="@../grid.edges"/>
            <IdentityMapping input="@../dofs" output="@Visual"/>
        </Node>
    </Node>

    <!-- Grid 3: x-axis graded r=1/3 — points dense at x=max -->
    <Node name="3D_X_graded_r0.33">
        <RegularGridTopology name="grid"
            n="9 9 9"
            min="26 0 0" max="36 10 10"
            gradingRatio="0.33 1 1"/>
        <MechanicalObject template="Vec3" name="dofs"/>
        <Node name="Visu">
            <OglModel name="Visual" color="0.2 0.8 0.3 1.0"
                edges="@../grid.edges"/>
            <IdentityMapping input="@../dofs" output="@Visual"/>
        </Node>
    </Node>

    <!-- ================================================================
         BOTTOM ROW: 2D quad grids (nz=1)
         ================================================================ -->

    <!-- Grid 4: uniform reference (r=1, default) -->
    <Node name="2D_Uniform">
        <RegularGridTopology name="grid"
            n="9 9 1"
            min="0 -13 0" max="10 -3 0"
            gradingRatio="1 1 1"/>
        <MechanicalObject template="Vec3" name="dofs"/>
        <Node name="Visu">
            <OglModel name="Visual" color="0.6 0.6 0.6 1.0"
                edges="@../grid.edges"/>
            <IdentityMapping input="@../dofs" output="@Visual"/>
        </Node>
    </Node>

    <!-- Grid 5: both axes graded r=3 — corner refinement at (xmin, ymin) -->
    <Node name="2D_XY_graded_r3">
        <RegularGridTopology name="grid"
            n="9 9 1"
            min="13 -13 0" max="23 -3 0"
            gradingRatio="3 3 1"/>
        <MechanicalObject template="Vec3" name="dofs"/>
        <Node name="Visu">
            <OglModel name="Visual" color="0.9 0.5 0.1 1.0"
                edges="@../grid.edges"/>
            <IdentityMapping input="@../dofs" output="@Visual"/>
        </Node>
    </Node>

    <!-- Grid 6: x graded r=3, y graded r=1/3 — refinement at opposite corners -->
    <Node name="2D_X3_Yr0.33">
        <RegularGridTopology name="grid"
            n="9 9 1"
            min="26 -13 0" max="36 -3 0"
            gradingRatio="3 0.33 1"/>
        <MechanicalObject template="Vec3" name="dofs"/>
        <Node name="Visu">
            <OglModel name="Visual" color="0.85 0.15 0.15 1.0"
                edges="@../grid.edges"/>
            <IdentityMapping input="@../dofs" output="@Visual"/>
        </Node>
    </Node>

</Node>
